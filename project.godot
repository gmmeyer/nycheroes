; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="New Game"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

WorldOrigin="*res://scripts/world/world_origin.gd"
Net="*res://scripts/net/net.gd"
Combat="*res://scripts/combat/combat.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="expand"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
look_left={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]
}
look_right={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]
}
look_up={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]
}
look_down={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
descend={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":67), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":7), Object(InputEventJoypadButton,"device":-1,"button_index":9)]
}
fly_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":70), Object(InputEventJoypadButton,"device":-1,"button_index":3)]
}
web={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69), Object(InputEventMouseButton,"device":-1,"button_index":2), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
debug_free_camera={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194332)]
}
coop_menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":77)]
}
time_of_day={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":84)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="heroes"
3d_physics/layer_3="npcs"
3d_physics/layer_4="ragdolls"
3d_physics/layer_5="water"

[physics]

3d/physics_engine="Jolt Physics"

[shader_globals]

night={
"type": "float",
"value": 0.0
}
dusk={
"type": "float",
"value": 0.0
}
city_lights={
"type": "float",
"value": 0.0
}
clock_hours={
"type": "float",
"value": 15.5
}
street_light_map={
"type": "sampler2D",
"value": ""
}
street_light_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
